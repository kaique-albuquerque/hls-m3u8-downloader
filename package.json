{
  "name": "streamgrab",
  "version": "0.1.0",
  "description": "Universal video downloader for HLS, DASH, YouTube and supported web platforms.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "download:curl": "node src/index.js --curl-impersonate",
    "download:youtube": "node src/index.js --youtube",
    "electron:dev": "electron .",
    "electron:serve": "electron .",
    "electron:install": "node scripts/install-electron.mjs",
    "test": "node --experimental-test-module-mocks --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\" && node tests/e2e/curl-e2e.mjs",
    "test:unit": "node --experimental-test-module-mocks --test \"tests/unit/*.test.js\"",
    "test:integration": "node --experimental-test-module-mocks --test \"tests/integration/*.test.js\"",
    "test:e2e": "node tests/e2e/curl-e2e.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "ffmpeg:install": "node scripts/install-ffmpeg.mjs",
    "postinstall": "node scripts/install-ffmpeg.mjs && node scripts/install-electron.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "streamgrab",
    "video",
    "downloader",
    "hls",
    "dash",
    "youtube",
    "yt-dlp",
    "ffmpeg",
    "curl-impersonate",
    "mdstrm",
    "mediastream",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.10.3",
    "eslint": "^10.8.1",
    "ntl": "^5.1.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "youtube-dl-exec": "^3.1.12"
  },
  "allowScripts": {
    "youtube-dl-exec@3.1.12": true,
    "electron@37.10.3": true
  }
}
