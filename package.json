{
  "name": "video-downloader",
  "version": "1.0.0",
  "description": "Downloader de vídeos HLS (.m3u8) com suporte automático à Mídia Stream (mdstrm) via curl-impersonate. Requer apenas Node.js — o FFmpeg é instalado automaticamente.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "download:curl": "node src/index.js --curl-impersonate",
    "test": "node test-curl-e2e.mjs",
    "ffmpeg:install": "node scripts/install-ffmpeg.mjs",
    "postinstall": "node scripts/install-ffmpeg.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "hls",
    "m3u8",
    "ffmpeg",
    "video-downloader",
    "curl-impersonate",
    "mdstrm",
    "mediastream",
    "cli",
    "stream"
  ],
  "license": "MIT",
  "devDependencies": {
    "ntl": "^5.1.0"
  }
}
